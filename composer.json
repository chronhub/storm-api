{
    "name": "chronhub/storm-api",
    "description": "Storm Api — HTTP exposure of a Storm application through the API Platform bridge.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["storm", "api-platform", "http", "cqrs", "event-sourcing"],
    "require": {
        "php": ">=8.5",
        "api-platform/http-cache": "^4.3.16",
        "api-platform/metadata": "^4.3.16",
        "api-platform/state": "^4.3.16",
        "api-platform/symfony": "^4.3.16",
        "api-platform/validator": "^4.3.16",
        "chronhub/storm-contracts": "self.version",
        "chronhub/storm-story": "self.version",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/property-access": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.3.0"
    },
    "autoload": {
        "psr-4": {
            "Storm\\Api\\": "./"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Storm\\Api\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
